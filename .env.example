# ─────────────────────────────────────────────────────────────
#  Session logging → private GitHub repo  (server-side only)
#  Copy to `.env` for local dev, and set the same vars in your
#  Vercel project settings for production. NEVER commit `.env`.
#  These values are read ONLY by the server (api/ + dev middleware);
#  they are never bundled into the client.
# ─────────────────────────────────────────────────────────────

# Fine-grained GitHub Personal Access Token with **Contents: Read and write**
# on the PRIVATE storage repo below (and nothing else).
GITHUB_TOKEN=

# Where sessions are stored. Use a PRIVATE repo you own.
GITHUB_OWNER=your-github-username
GITHUB_REPO=moksha-responses
GITHUB_BRANCH=main

# Folder inside that repo (one markdown file per session lands here).
SESSIONS_DIR=responses/sessions

# Password to open the /admin dashboard. Leave empty to disable /admin entirely.
ADMIN_PASSWORD=
